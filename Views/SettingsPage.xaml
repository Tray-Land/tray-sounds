<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TraySounds.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Grid">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ColumnSpacing" Value="12" />
        </Style>
    </Page.Resources>

    <Grid Padding="16,12,12,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Orientation="Horizontal" Spacing="4">
            <Button
                x:Name="BackButton"
                Margin="-8,0,0,0"
                AutomationProperties.Name="Back"
                Click="BackButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Back">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Settings" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,0,-8,0">
            <StackPanel Margin="0,0,8,0" Spacing="4">
                <TextBlock
                    Margin="0,0,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Playback" />
                <Grid Style="{StaticResource CardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="One sound at a time" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Starting a sound stops the one playing. Turn off to layer sounds."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="OneAtATimeToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="One sound at a time"
                        OffContent=""
                        OnContent=""
                        Toggled="OneAtATimeToggle_Toggled" />
                </Grid>

                <TextBlock
                    Margin="0,16,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Board" />
                <Grid Style="{StaticResource CardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Grid size" />
                        <TextBlock
                            x:Name="GridSizeDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Slider
                        x:Name="GridSizeSlider"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Tiles per row"
                        Maximum="5"
                        Minimum="2"
                        SnapsTo="StepValues"
                        StepFrequency="1"
                        TickFrequency="1"
                        TickPlacement="BottomRight"
                        ValueChanged="GridSizeSlider_ValueChanged" />
                </Grid>

                <TextBlock
                    Margin="0,16,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="General" />
                <Grid Style="{StaticResource CardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" />
                        <TextBlock
                            x:Name="StartupDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Keep the soundboard ready after you sign in."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="StartupToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="Start with Windows"
                        IsEnabled="False"
                        OffContent=""
                        OnContent=""
                        Toggled="StartupToggle_Toggled" />
                </Grid>
                <Grid Style="{StaticResource CardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Your sounds folder" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Copies of the sounds you've added and recorded."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Open your sounds folder"
                        Click="OpenFolder_Click"
                        Content="Open" />
                </Grid>

                <TextBlock
                    x:Name="VersionText"
                    Margin="0,16,0,0"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
