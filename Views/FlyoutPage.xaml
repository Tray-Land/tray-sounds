<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TraySounds.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:TraySounds.Views"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="TileContainerStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="TileTemplate" x:DataType="views:SoundTile">
            <Border
                Margin="3"
                Padding="4,8,4,0"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                ContextRequested="Tile_ContextRequested"
                CornerRadius="4"
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                Tag="{x:Bind}"
                ToolTipService.ToolTip="{x:Bind ToolTip}">
                <Grid RowSpacing="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="2,-4,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Hotkey, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Emoji"
                        FontSize="26"
                        Text="{x:Bind Emoji}" />
                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <ProgressBar
                        Grid.Row="2"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        Visibility="{x:Bind IsPlaying, Mode=OneWay}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="16,12,12,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Tray Sounds" />
            <Button
                Grid.Column="1"
                AutomationProperties.Name="Settings"
                Click="SettingsButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            IsOpen="False"
            Severity="Warning" />

        <!--  Drag a tile to rearrange; the GridView is the scroller so dragging can auto-scroll  -->
        <GridView
            x:Name="TileGrid"
            Grid.Row="2"
            Margin="0,0,-8,0"
            Padding="0,0,8,4"
            AllowDrop="True"
            AutomationProperties.Name="Sounds"
            CanDragItems="True"
            CanReorderItems="True"
            DragItemsCompleted="TileGrid_DragItemsCompleted"
            IsItemClickEnabled="True"
            ItemClick="TileGrid_ItemClick"
            ItemContainerStyle="{StaticResource TileContainerStyle}"
            ItemTemplate="{StaticResource TileTemplate}"
            SelectionMode="None"
            SizeChanged="TileGrid_SizeChanged">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.Footer>
                <!--  Add a sound: below the grid so the board stays the focus  -->
                <Button
                    Margin="3,8,0,0"
                    AutomationProperties.Name="Add a sound"
                    Click="AddSound_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Add a sound" />
                    </StackPanel>
                </Button>
            </GridView.Footer>
        </GridView>

        <!--  Footer: volume and stop  -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                x:Name="VolumeIcon"
                Margin="4,0,0,0"
                FontSize="16"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE767;" />
            <Slider
                x:Name="VolumeSlider"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="Volume"
                Maximum="100"
                Minimum="0"
                StepFrequency="1"
                ValueChanged="VolumeSlider_ValueChanged" />
            <Button
                x:Name="StopButton"
                Grid.Column="2"
                AutomationProperties.Name="Stop all sounds"
                Click="StopButton_Click"
                IsEnabled="False"
                ToolTipService.ToolTip="Stop all sounds">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE71A;" />
                    <TextBlock Text="Stop" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
