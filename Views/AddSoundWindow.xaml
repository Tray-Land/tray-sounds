<?xml version="1.0" encoding="utf-8"?>
<ex:WindowEx
    x:Class="TraySounds.Views.AddSoundWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ex="using:WinUIEx"
    Title="Add a sound">

    <ex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </ex:WindowEx.SystemBackdrop>

    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Add a sound">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/StoreLogo.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <StackPanel
            Grid.Row="1"
            Padding="24,8,24,16"
            Spacing="16">

            <!--  Source card: empty → recording → ready. Also a drop target for audio files.  -->
            <Grid
                x:Name="SourceCard"
                MinHeight="148"
                Padding="16"
                AllowDrop="True"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                DragLeave="SourceCard_DragLeave"
                DragOver="SourceCard_DragOver"
                Drop="SourceCard_Drop">

                <StackPanel
                    x:Name="EmptyPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <ComboBox
                        x:Name="SourceBox"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Record from"
                        SelectedIndex="0">
                        <ComboBoxItem Content="Microphone" />
                        <ComboBoxItem Content="System audio" />
                    </ComboBox>
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="RecordButton"
                            AutomationProperties.Name="Record"
                            Click="RecordButton_Click"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE720;" />
                                <TextBlock Text="Record" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ChooseButton"
                            AutomationProperties.Name="Choose file"
                            Click="ChooseButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                <TextBlock Text="Choose file" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock
                        x:Name="DropHint"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Or drop an audio file here" />
                </StackPanel>

                <StackPanel
                    x:Name="RecordingPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Ellipse
                            x:Name="RecordingDot"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock
                            x:Name="RecordingTime"
                            AutomationProperties.LiveSetting="Off"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="0:00" />
                    </StackPanel>
                    <Canvas
                        x:Name="WaveCanvas"
                        Width="240"
                        Height="40"
                        HorizontalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock
                        x:Name="RecordingDevice"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxWidth="320"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Name="StopRecordingButton"
                        AutomationProperties.Name="Stop recording"
                        HorizontalAlignment="Center"
                        Click="StopRecordingButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="12" Glyph="&#xE71A;" />
                            <TextBlock Text="Stop recording" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="RecordingLimit"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>

                <StackPanel
                    x:Name="ReadyPanel"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ReadyEmoji"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Emoji"
                        FontSize="32" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <TextBlock
                            x:Name="ReadyDescription"
                            MaxLines="2"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="PreviewButton"
                                AutomationProperties.Name="Preview"
                                Click="PreviewButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        x:Name="PreviewIcon"
                                        FontSize="12"
                                        Glyph="&#xE768;" />
                                    <TextBlock x:Name="PreviewText" Text="Preview" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="StartOverButton"
                                Click="StartOver_Click"
                                Content="Start over" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!--  Trim: the waveform with the range selector laid over it.  -->
                <StackPanel Spacing="4">
                    <Grid x:Name="WaveformHost" Height="64">
                        <Path
                            x:Name="WaveformPath"
                            Height="48"
                            Margin="12,0"
                            AutomationProperties.AccessibilityView="Raw"
                            Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                            StrokeThickness="1.5" />
                        <Path
                            x:Name="WaveformSelectedPath"
                            Height="48"
                            Margin="12,0"
                            AutomationProperties.AccessibilityView="Raw"
                            Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                            StrokeThickness="1.5" />
                        <ProgressRing
                            x:Name="WaveformLoading"
                            Width="24"
                            Height="24"
                            IsActive="False" />
                        <controls:RangeSelector
                            x:Name="TrimSelector"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Trim"
                            IsEnabled="False"
                            Maximum="1000"
                            Minimum="0"
                            RangeEnd="1000"
                            RangeStart="0"
                            StepFrequency="10"
                            ValueChanged="TrimSelector_ValueChanged" />
                    </Grid>
                    <Grid>
                        <TextBlock
                            x:Name="TrimStartText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock
                            x:Name="TrimLengthText"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock
                            x:Name="TrimEndText"
                            HorizontalAlignment="Right"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </Grid>
                </StackPanel>
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Emoji" />
                    <Button
                        x:Name="EmojiButton"
                        Width="56"
                        Height="32"
                        Padding="0"
                        AutomationProperties.Name="Choose an emoji"
                        ToolTipService.ToolTip="Choose an emoji">
                        <TextBlock
                            x:Name="EmojiText"
                            FontFamily="Segoe UI Emoji"
                            FontSize="18" />
                        <Button.Flyout>
                            <Flyout x:Name="EmojiFlyout" Placement="BottomEdgeAlignedLeft" />
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <TextBox
                    x:Name="NameBox"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Header="Name"
                    MaxLength="32"
                    PlaceholderText="What should the button say?"
                    TextChanged="NameBox_TextChanged" />
            </Grid>

            <InfoBar
                x:Name="ErrorBar"
                IsOpen="False"
                Severity="Warning" />
        </StackPanel>

        <!--  Footer  -->
        <Grid
            Grid.Row="2"
            Padding="24,16"
            Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="AddButton"
                    MinWidth="96"
                    Click="AddButton_Click"
                    Content="Add"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    MinWidth="96"
                    Click="CancelButton_Click"
                    Content="Cancel" />
            </StackPanel>
        </Grid>
    </Grid>
</ex:WindowEx>
