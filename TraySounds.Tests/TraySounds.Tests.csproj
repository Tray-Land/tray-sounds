<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinRT-free logic from the app, linked rather than referenced (the app is a WinUI exe). -->
    <Compile Include="..\Services\SoundNamePolicy.cs" Link="Linked\SoundNamePolicy.cs" />
    <Compile Include="..\Services\SoundOrderPolicy.cs" Link="Linked\SoundOrderPolicy.cs" />
    <Compile Include="..\Services\SoundCreditPolicy.cs" Link="Linked\SoundCreditPolicy.cs" />
    <Compile Include="..\Services\SoundTrimPolicy.cs" Link="Linked\SoundTrimPolicy.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*" />
  </ItemGroup>

</Project>
